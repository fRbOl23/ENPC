{
 "cells": [
  {"cell_type": "markdown", "metadata": {}, "source": ["# OPTI"]},
  {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["using JuMP, HiGHS, Plots"]},
  {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": [
    "model = Model(HiGHS.Optimizer)\n",
    "set_silent(model)\n",
    "@variable(model, x >= 0)\n",
    "@variable(model, y >= 0)\n",
    "@constraint(model, x + 2y <= 4)\n",
    "@objective(model, Max, 3x + y)\n",
    "optimize!(model)\n",
    "value(x), value(y), objective_value(model)"
  ]}
 ],
 "metadata": {
